# Backend API

# Database
# Use a direct connection for migrations and a pooled connection for the app when needed.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB_NAME?sslmode=require&channel_binding=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DB_NAME?sslmode=require&channel_binding=require
DATABASE_URL_POOLED=postgresql://USER:PASSWORD@POOLER_HOST/DB_NAME?sslmode=require&channel_binding=require

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# CORS
CORS_ORIGIN=http://localhost:5173

# Internal AI
# OPENAI_API_KEY=set-in-your-local-env-or-hosting-provider
