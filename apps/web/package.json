{
  "name": "devnote-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --build && vite build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --build --noEmit",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@playwright/test": "^1.64.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.0",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@devnote/api-client": "workspace:*",
    "@devnote/contracts": "workspace:*",
    "@hookform/resolvers": "^5.9.2",
    "@tanstack/react-query": "^5.104.4",
    "@uiw/react-markdown-preview": "^5.2.1",
    "@uiw/react-md-editor": "^4.1.2",
    "autoprefixer": "^10.6.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.59.0",
    "postcss": "^8.5.30",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-hook-form": "^7.90.0",
    "tailwind-merge": "^3.7.0",
    "workbox-window": "^7.4.1",
    "zod": "^4.6.7"
  }
}
