{
  "version": 2,
  "builds": [
    {
      "src": "apps/web/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "apps/api/src/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["node_modules/**", "prisma/**"]
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/apps/api/src/index.ts" },
    { "src": "/(.*)", "dest": "/apps/web/$1" }
  ]
}
